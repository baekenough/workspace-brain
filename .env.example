# workspace-brain environment reference.
# The Go binary reads process environment variables; it does not load .env files by itself.

# HTTP server listen address.
ADDR=:8080

# Frontend adapters. Configure at least one.
# API_TOKEN enables the JSON HTTP API at POST /api/commands.
# Use a high-entropy secret outside local demos.
API_TOKEN=change-me

# SLACK_SIGNING_SECRET enables Slack slash-command and interactivity routes.
# Leave empty when you only run the JSON HTTP adapter.
SLACK_SIGNING_SECRET=

# Comma-separated Slack user IDs granted the admin role by the Slack adapter.
ADMIN_USERS=U123,U456

# Slack manifest and slash-command settings.
# PUBLIC_BASE_URL enables GET /slack/manifest.json. Use public HTTPS for Slack registration.
PUBLIC_BASE_URL=https://workspace-brain.example.com
COMMAND_NAME=brain
SLACK_APP_NAME=workspace-brain

# Optional local JSON snapshot persistence for the memory core.
# When set, the server creates this directory with 0700 permissions and stores memory.json inside it.
# This is local durability, not managed production storage.
DATA_PATH=./var/workspace-brain
READINESS_REQUIRED=false

# HTTP hardening timeouts. Values use Go duration syntax.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Optional OpenAI-compatible provider seam.
# The default server path does not use these values; it runs the local memory core.
# Set them only in code paths that explicitly construct internal/core/ai clients.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_RESPONSE_MODEL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# ─── Local dependency service connections ─────────────────────────────────────
# These variables wire the app to the services started by `make dev-up`
# (docker-compose.yml: postgres, qdrant, rabbitmq).
# The defaults below match the local Compose stack credentials.
# Override for staging/production deployments.

# PostgreSQL — used by internal/core/postgres. Pass as a full DSN.
# Compose service: postgres (localhost:5432)
POSTGRES_DSN=postgres://brain:brain_local@localhost:5432/brain?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain_local
POSTGRES_DB=brain

# Qdrant vector store — used by internal/core/qdrant. HTTP REST endpoint.
# Compose service: qdrant (localhost:6333 REST, localhost:6334 gRPC)
QDRANT_URL=http://localhost:6333

# RabbitMQ — planned ingest queue backend. AMQP connection URL.
# Compose service: rabbitmq (localhost:5672 AMQP, localhost:15672 management UI)
RABBITMQ_URL=amqp://brain:brain_local@localhost:5672/brain
